---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const projects = (await getCollection("projects", (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" section="projects">
  <div class="page">
    <p class="lead">Things I've built, mostly at the intersection of healthcare, optimization and data systems.</p>
    <section class="ptiles">
      {projects.map((p) => {
        const stat = p.data.stats[0];
        const inner = (
          <>
            <div class="art">
              {p.data.cover
                ? <img src={p.data.cover} alt="" loading="lazy" />
                : stat
                  ? <div class="big"><b>{stat.value}</b><span>{stat.label}</span></div>
                  : <div class="big"><span>{p.data.stack.slice(0, 2).join(" · ")}</span></div>}
            </div>
            <span class="when">{p.data.when}{p.data.with && ` · ${p.data.with}`}</span>
            <b>{p.data.title}</b>
            <small>{p.data.summary}</small>
            {p.data.stack.length > 0 && <span class="tags">{p.data.stack.join(" · ")}</span>}
          </>
        );
        const ext = p.data.links;
        const tile = p.data.page
          ? <a class="ptile" href={`/projects/${p.id}`}>{inner}</a>
          : ext.length > 0
            ? <a class="ptile ext" href={ext[0].href} target="_blank" rel="noopener">{inner}</a>
            : <div class="ptile">{inner}</div>;
        return (
          <div class="pcard">
            {tile}
            {ext.length > 0 && (
              <div class="plinks">
                {ext.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
              </div>
            )}
          </div>
        );
      })}
    </section>
  </div>
</Base>
