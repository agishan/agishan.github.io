---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const projects = (await getCollection("projects", (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" section="projects">
  <div class="page">
    <p class="lead">Things I've built, mostly at the intersection of healthcare, optimization and data systems.</p>
    <section>
      <ul class="rows">
        {projects.map((p) => {
          const inner = (
            <>
              <b>{p.data.title}</b>
              <small>{p.data.summary}</small>
              {p.data.stack.length > 0 && <span class="tags">{p.data.stack.join(" · ")}</span>}
            </>
          );
          return (
            <li>
              <span class="when">{p.data.when}</span>
              {p.data.page
                ? <a class="what" href={`/projects/${p.id}`}>{inner}</a>
                : <span class="what">{inner}</span>}
            </li>
          );
        })}
      </ul>
    </section>
  </div>
</Base>
