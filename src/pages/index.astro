---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---
<Base section="about">
  <div class="page">
    <section class="prose">
      <p class="lead">
        {site.lead}{" "}
        <span class="rot" aria-hidden="true"><span class="rot-track">{[...site.titles, site.titles[0]].map((t) => <span>{t}</span>)}</span></span><span class="rot-static">{site.titles.join(", ")}</span>.
      </p>
      {site.bio.map((p) => <p>{p}</p>)}
      {site.now && <p class="now"><b>Now:</b> {site.now}</p>}
    </section>

    <section class="photos" aria-label="Photos">
      {site.photos.map((p) =>
        p.src
          ? (
            <figure class="pfig">
              <a href={p.full || p.src} data-full={p.full || p.src} data-caption={[p.date, p.caption].filter(Boolean).join(" · ")} aria-label={`View full photo: ${p.alt}`}>
                <img class="photo" src={p.src} alt={p.alt} loading="lazy" />
              </a>
              {(p.date || p.caption) && (
                <figcaption>{p.date && <span class="pdate">{p.date}</span>}{p.caption}</figcaption>
              )}
            </figure>
          )
          : <div class="photo">photo · {p.alt}</div>
      )}
    </section>

    <section class="prose">
      <p>{site.reachOut}</p>
    </section>

    <section class="social" aria-label="Elsewhere">
      {site.socials.map((s) => <a href={s.href} rel="me">{s.label}</a>)}
      {site.resume && <a href={site.resume}>Resume (PDF)</a>}
    </section>
  </div>

  <dialog class="lightbox" aria-label="Photo">
    <button class="lb-close" aria-label="Close">×</button>
    <img alt="" />
    <p class="lb-cap"></p>
  </dialog>
</Base>

<script>
  // Title rotator: slides to the next title every 2.2s and eases the width to fit it.
  const rot = document.querySelector<HTMLElement>(".rot");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (rot && !reduce) {
    const track = rot.querySelector<HTMLElement>(".rot-track")!;
    const items = [...track.children] as HTMLElement[];
    const n = items.length - 1; // last item is a copy of the first, for a seamless loop
    let i = 0;
    const fit = () => { rot.style.width = items[i].offsetWidth + "px"; };
    document.documentElement.classList.add("rot-on");
    fit();
    addEventListener("resize", fit);
    setInterval(() => {
      i++;
      track.style.transition = "";
      track.style.transform = `translateY(${-i * 100 / items.length}%)`;
      fit();
      if (i === n) {
        setTimeout(() => {
          track.style.transition = "none";
          i = 0;
          track.style.transform = "translateY(0)";
        }, 700);
      }
    }, 2200);
  }

  const dlg = document.querySelector<HTMLDialogElement>("dialog.lightbox")!;
  const img = dlg.querySelector("img")!;
  const cap = dlg.querySelector<HTMLParagraphElement>(".lb-cap")!;
  document.querySelectorAll<HTMLAnchorElement>(".pfig a[data-full]").forEach((a) => {
    a.addEventListener("click", (e) => {
      if (typeof dlg.showModal !== "function") return; // old browsers just follow the link
      e.preventDefault();
      img.src = a.dataset.full!;
      img.alt = a.querySelector("img")?.alt ?? "";
      cap.textContent = a.dataset.caption ?? "";
      dlg.showModal();
    });
  });
  // Click anywhere (backdrop, image, ×) closes it; Escape works natively.
  dlg.addEventListener("click", () => dlg.close());
  dlg.addEventListener("close", () => img.removeAttribute("src"));
</script>
